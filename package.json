    "configuration": {
      "title": "S3 Explorer",
      "properties": {
        "s3Explorer.pageSize": {
          "type": "integer",
          "default": 1000,
          "minimum": 100,
          "maximum": 1000,
          "description": "Keys listed per page in the tree. A \"Load more\" row fetches the next page."
        },
        "s3Explorer.maxTextPreviewMB": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 512,
          "description": "Text objects larger than this ask first: show the first 1 MB (one range request) or download the whole file."
        },
        "s3Explorer.confirmOpenOverMB": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Binary objects larger than this ask before they are downloaded to open."
        },
        "s3Explorer.multipartThresholdMB": {
          "type": "number",
          "default": 16,
          "minimum": 5,
          "description": "Files at least this large upload in parts, with progress, Cancel and resume."
        },
        "s3Explorer.partSizeMB": {
          "type": "number",
          "default": 8,
          "minimum": 5,
          "maximum": 512,
          "description": "Smallest part size for multipart uploads. It grows for very large files so that there are at most 10,000 parts."
        },
        "s3Explorer.concurrency": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Parts or files sent at the same time."
        },
        "s3Explorer.requestTimeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 3,
          "maximum": 600,
          "description": "How long to wait for an answer from the endpoint before showing an error."
        },
        "s3Explorer.syncExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git/**",
            "node_modules/**",
            ".DS_Store",
            "Thumbs.db"
          ],
          "description": "Glob patterns that uploads and sync skip (** matches folders)."
        },
        "s3Explorer.pricePerGBMonth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Storage price in USD per GB-month for the size report estimate. 0 uses the provider's list price (AWS S3 Standard 0.023, R2 0.015, B2 0.006, Wasabi 0.0069)."
        },
        "s3Explorer.showAwsProfiles": {
          "type": "boolean",
          "default": true,
          "description": "List the profile names in ~/.aws/config and ~/.aws/credentials in the tree so you can connect with one click. Only names are read until you pick one."
        },
        "s3Explorer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a Marketplace rating after 2 objects opened without an error, in 2 sessions at least 4 hours apart. \"Later\" asks once more after 7 days, \"No thanks\" never asks again. Never after an error. Nothing is sent anywhere."
        },
        "s3Explorer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Rate, More free tools and Sponsor links at the bottom of the details, sync and report pages. Nothing is sent anywhere."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "s3Explorer.start",
        "title": "Get started with S3 Explorer",
        "description": "Browse, open, upload and sync S3 buckets from VS Code.",
        "steps": [
          {
            "id": "connect",
            "title": "Add a connection",
            "description": "Pick an AWS profile from ~/.aws (SSO profiles reuse your aws sso login), or enter an access key for AWS, Cloudflare R2, MinIO, Backblaze B2, Wasabi or DigitalOcean Spaces. Keys go to the OS keychain.\n[Add Connection](command:s3Explorer.addConnection)",
            "media": {
              "image": "images/screenshot-dark.png",
              "altText": "The S3 Buckets view with a bucket open and the details of an object."
            },
            "completionEvents": [
              "onCommand:s3Explorer.addConnection",
              "onCommand:s3Explorer.connectProfile"
            ]
          },
          {
            "id": "browse",
            "title": "Browse and open",
            "description": "Expand a bucket. Keys load 1,000 at a time, so a bucket with millions of keys opens at once. Click an object to open it read-only; PDFs, spreadsheets, images and Parquet open in the matching viewer.",
            "media": {
              "markdown": "walkthrough/browse.md"
            }
          },
          {
            "id": "transfer",
            "title": "Upload, download and edit",
            "description": "Drag files from the Explorer onto a bucket, or right-click a folder. Large files upload in parts and can resume. Every delete and overwrite lists the keys and asks first.",
            "media": {
              "markdown": "walkthrough/transfer.md"
            }
          },
          {
            "id": "sync",
            "title": "Sync a folder",
            "description": "Right-click a bucket or folder and choose Sync Folder. You see a dry-run plan (new, changed, deleted) before anything changes.",
            "media": {
              "markdown": "walkthrough/sync.md"
            },
            "completionEvents": [
              "onCommand:s3Explorer.sync"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js --production",
    "test": "node scripts/build.js --production && node --test --test-concurrency=1 test/*.test.js",
    "package": "npm run build && npx -y @vscode/vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
