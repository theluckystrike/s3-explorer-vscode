{
  "name": "zovo-s3-explorer",
  "displayName": "S3 Explorer & S3 Client, Bucket Browser for AWS, MinIO and Cloudflare R2",
  "description": "Free S3 client inside VS Code: browse buckets with millions of keys, open objects read-only, upload large files with resume, download, copy, move, delete (always asks first), versions, tags, presigned URLs and folder sync with a dry run. Works with AWS profiles (SSO too), MinIO, Cloudflare R2, Backblaze B2, Wasabi and DigitalOcean Spaces. No sign-in, no telemetry.",
  "version": "0.1.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B2433",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "s3",
    "aws s3",
    "s3 explorer",
    "s3 browser",
    "s3 client",
    "s3 bucket",
    "bucket browser",
    "minio",
    "cloudflare r2",
    "r2",
    "backblaze b2",
    "wasabi",
    "digitalocean spaces",
    "object storage",
    "presigned url",
    "multipart upload",
    "aws",
    "s3 sync",
    "aws sso",
    "s3-compatible"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:s3x"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
